[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://lobby/lobby.gd" id="1_lobby"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lobby")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.055, 0.065, 0.085, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "DART PARTY · 2~4인 로비"

[node name="NameInput" type="LineEdit" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "플레이어 이름"
max_length = 20

[node name="AccountControls" type="VBoxContainer" parent="Margin/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="PasswordInput" type="LineEdit" parent="Margin/Content/AccountControls"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "로컬 개발용 비밀번호 (8~128자, 최초 로그인 시 계정 생성)"
max_length = 128
secret = true

[node name="AccountButtons" type="HBoxContainer" parent="Margin/Content/AccountControls"]
layout_mode = 2

[node name="LoginButton" type="Button" parent="Margin/Content/AccountControls/AccountButtons"]
unique_name_in_owner = true
layout_mode = 2
text = "개발 계정 로그인 / 생성"

[node name="RefreshProfile" type="Button" parent="Margin/Content/AccountControls/AccountButtons"]
unique_name_in_owner = true
layout_mode = 2
text = "전적 새로고침"

[node name="ProfileLabel" type="Label" parent="Margin/Content/AccountControls"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
text = "개발 계정 로그인 전 (Steam 계정 아님)"

[node name="Connection" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="AddressInput" type="LineEdit" parent="Margin/Content/Connection"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "127.0.0.1"
placeholder_text = "방장 IP 주소"

[node name="PortInput" type="SpinBox" parent="Margin/Content/Connection"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
min_value = 1024.0
max_value = 65535.0
value = 7000.0
prefix = "포트 "

[node name="ConnectButtons" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HostButton" type="Button" parent="Margin/Content/ConnectButtons"]
unique_name_in_owner = true
layout_mode = 2
text = "방 만들기"

[node name="JoinButton" type="Button" parent="Margin/Content/ConnectButtons"]
unique_name_in_owner = true
layout_mode = 2
text = "방 참가"

[node name="StatusLabel" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[node name="PlayersLabel" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="RoomButtons" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ReadyButton" type="CheckButton" parent="Margin/Content/RoomButtons"]
unique_name_in_owner = true
layout_mode = 2
text = "준비"

[node name="StartButton" type="Button" parent="Margin/Content/RoomButtons"]
unique_name_in_owner = true
layout_mode = 2
text = "함께 시작"

[node name="LeaveButton" type="Button" parent="Margin/Content/RoomButtons"]
unique_name_in_owner = true
layout_mode = 2
text = "나가기 / 접속 취소"

[node name="Help" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "같은 PC: 127.0.0.1 · 같은 LAN: 방장의 내부 IP · 같은 포트를 사용하세요."
autowrap_mode = 2

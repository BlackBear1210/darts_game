# 생성되는 Godot 캐시와 검증 결과
.godot/

# Python 검증 실행 시 생성되는 파일
__pycache__/
*.py[cod]

# 로컬 검증용 Godot 설정
override.cfg

# V08 원본·미리보기는 공유하고 중복 압축본·자동 백업·작업 로그는 제외
/output/character_v08/*.blend1
/output/character_v08/*.blend2
/output/character_v08/*.zip
/output/character_v08/*.log

# render_game_look 던지기 장면 낱장(GIF 만드는 중간 파일). 팀 공유는 11_throw.gif 만
/output/game_look/throw_frames/
